# Copy to .env.local and fill in. Nothing here is committed.

# Public site URL (used for metadata / OG tags)
NEXT_PUBLIC_SITE_URL=https://vjsflowers.com

# Supabase — create the project, then run supabase/migrations/0001_init.sql
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shop admin login. ADMIN_PASSWORD is what Vince types; the secret signs
# his session cookie (generate with: openssl rand -base64 32).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
