# Copy to .env.local and fill in. Nothing here is committed.

# Public site URL. Every canonical, og:url and sitemap entry is built from
# this, so production MUST be the real https origin. Leave it unset locally:
# lib/site.ts already falls back to the production domain, and a production
# build with a non-https origin throws rather than shipping bad canonicals.
NEXT_PUBLIC_SITE_URL=https://vjsflowers.com

# Shop admin login. ADMIN_PASSWORD is what Vince types; the secret signs
# his session cookie (generate with: openssl rand -base64 32).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
